<div class="page-head">
  <div>
    <h2>รายละเอียดวัตถุมงคล</h2>
    <p>ดูข้อมูล รูปภาพ และประวัติของรายการนี้</p>
  </div>

  <a href="/dashboard" class="btn secondary">ย้อนกลับ</a>
</div>

<div class="detail-layout">
  <div class="detail-card">

    <div class="detail-main-image carousel-box">
      <% const totalCarouselImages = (item.image ? 1 : 0) + images.length; %>

      <% if (totalCarouselImages > 0) { %>

        <% if (item.image) { %>
          <div class="carousel-slide active">
            <img 
              src="/uploads/<%= item.image %>" 
              alt="<%= item.name %>"
              class="click-full-image"
              data-full="/uploads/<%= item.image %>"
            >

            <div class="slide-caption">
              รูปหลัก
            </div>
          </div>
        <% } %>

        <% images.forEach((img, index) => { %>
          <div class="carousel-slide <%= !item.image && index === 0 ? 'active' : '' %>">
            <img 
              src="/uploads/<%= img.filename %>" 
              alt="<%= img.caption || 'รูปเพิ่มเติม' %>"
              class="click-full-image"
              data-full="/uploads/<%= img.filename %>"
            >

            <div class="slide-caption">
              <%= img.caption || 'รูปเพิ่มเติม' %>
            </div>

            <% if (user.role === 'admin') { %>
              <form 
                method="POST" 
                action="/admin/item-images/<%= img.id %>/delete"
                class="carousel-delete-form"
                onsubmit="return confirm('ยืนยันการลบรูปนี้?')"
              >
                <button type="submit" class="danger small-delete-btn">
                  ลบรูป
                </button>
              </form>
            <% } %>
          </div>
        <% }) %>

        <% if (totalCarouselImages > 1) { %>
          <button type="button" class="carousel-btn carousel-prev" id="carouselPrev">
            ‹
          </button>

          <button type="button" class="carousel-btn carousel-next" id="carouselNext">
            ›
          </button>

          <div class="carousel-counter">
            <span id="carouselCurrent">1</span> / <%= totalCarouselImages %>
          </div>
        <% } %>

        <div class="image-full-hint">
          คลิกเพื่อดูภาพเต็มจอ
        </div>

      <% } else { %>
        <div class="no-image">ไม่มีรูปภาพ</div>
      <% } %>
    </div>

    <div class="detail-info">
      <span class="code large-code"><%= item.code %></span>

      <h2><%= item.name %></h2>

      <p>
        <b>หมวดหมู่:</b>
        <%= item.category || '-' %>
      </p>

      <p>
        <b>สถานที่เก็บ:</b>
        <%= item.location || '-' %>
      </p>

      <p>
        <b>หน่วยนับ:</b>
        <%= item.unit || 'ชิ้น' %>
      </p>

      <% if (item.description) { %>
  <div class="item-description-box">
    <h3>ประวัติความเป็นมา</h3>
    <div class="item-description-text">
      <%= item.description %>
    </div>
  </div>
<% } %>

      <div class="qty detail-qty">
        คงเหลือ:
        <strong><%= item.qty %></strong>
        <%= item.unit || 'ชิ้น' %>
      </div>

      <% if (item.qty > 0) { %>
        <a class="btn" href="/withdraw/<%= item.id %>">เบิกวัตถุมงคล</a>
      <% } else { %>
        <button class="btn disabled" disabled>ของหมด</button>
      <% } %>
    </div>

  </div>
</div>

<% if (user.role === 'admin') { %>
  <div class="form-card upload-more-card">
    <h2>อัปโหลดรูปภาพเพิ่มเติม</h2>

    <form 
      method="POST" 
      action="/admin/items/<%= item.id %>/images" 
      enctype="multipart/form-data"
    >
      <label>เลือกรูปภาพเพิ่มเติม</label>
      <input type="file" name="images" accept="image/*" multiple required>

      <label>คำอธิบายรูปภาพ</label>
      <input 
        type="text" 
        name="caption" 
        placeholder="เช่น ด้านหน้า / ด้านหลัง / กล่อง / อุปกรณ์ประกอบ"
      >

      <button type="submit">อัปโหลดรูปเพิ่มเติม</button>
    </form>
  </div>
<% } %>

<div class="table-card history-detail-card">
  <h2>ประวัติรายการนี้</h2>

  <table>
    <thead>
      <tr>
        <th>วันที่</th>
        <th>ประเภท</th>
        <th>จำนวน</th>
        <th>ผู้ทำรายการ</th>
        <th>หมายเหตุ</th>
      </tr>
    </thead>

    <tbody>
      <% if (transactions.length === 0) { %>
        <tr>
          <td colspan="5" style="text-align:center;">
            ยังไม่มีประวัติของรายการนี้
          </td>
        </tr>
      <% } %>

      <% transactions.forEach(row => { %>
        <tr>
          <td><%= row.created_at %></td>

          <td>
            <% if (row.type === 'RECEIVE') { %>
              <span class="status receive">รับเข้า</span>
            <% } else { %>
              <span class="status issue">เบิกออก</span>
            <% } %>
          </td>

          <td>
            <%= row.qty %>
            <%= item.unit || 'ชิ้น' %>
          </td>

          <td><%= row.user_name %></td>
          <td><%= row.note || '-' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div id="imageModal" class="image-modal">
  <button type="button" class="image-modal-close" id="closeImageModal">
    ×
  </button>

  <button type="button" class="modal-arrow modal-arrow-left" id="modalPrev">
    ‹
  </button>

  <img id="modalImage" src="" alt="ภาพเต็มจอ">

  <button type="button" class="modal-arrow modal-arrow-right" id="modalNext">
    ›
  </button>

  <div class="modal-counter">
    <span id="modalCurrent">1</span> / <span id="modalTotal">1</span>
  </div>

  <div class="image-modal-text">
    กดลูกศรซ้าย/ขวาเพื่อเปลี่ยนภาพ หรือกด × เพื่อปิด
  </div>
</div>

<script>
  // ==========================
  // Carousel เลื่อนรูปภาพด้านบน
  // ==========================
  const slides = document.querySelectorAll(".carousel-slide");
  const prevBtn = document.getElementById("carouselPrev");
  const nextBtn = document.getElementById("carouselNext");
  const currentText = document.getElementById("carouselCurrent");

  let currentSlide = 0;

  function showSlide(index) {
    if (!slides || slides.length === 0) return;

    if (index < 0) {
      currentSlide = slides.length - 1;
    } else if (index >= slides.length) {
      currentSlide = 0;
    } else {
      currentSlide = index;
    }

    slides.forEach(function (slide, i) {
      if (i === currentSlide) {
        slide.classList.add("active");
      } else {
        slide.classList.remove("active");
      }
    });

    if (currentText) {
      currentText.textContent = currentSlide + 1;
    }
  }

  if (prevBtn) {
    prevBtn.addEventListener("click", function () {
      showSlide(currentSlide - 1);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener("click", function () {
      showSlide(currentSlide + 1);
    });
  }

  // ==========================
  // Modal ภาพเต็มจอ พร้อมลูกศร
  // ==========================
  const imageModal = document.getElementById("imageModal");
  const modalImage = document.getElementById("modalImage");
  const closeImageModal = document.getElementById("closeImageModal");

  const modalPrev = document.getElementById("modalPrev");
  const modalNext = document.getElementById("modalNext");
  const modalCurrent = document.getElementById("modalCurrent");
  const modalTotal = document.getElementById("modalTotal");

  const fullImages = Array.from(document.querySelectorAll(".click-full-image"));

  let currentModalIndex = 0;

  if (modalTotal) {
    modalTotal.textContent = fullImages.length;
  }

  function showModalImage(index) {
    if (fullImages.length === 0) return;

    if (index < 0) {
      currentModalIndex = fullImages.length - 1;
    } else if (index >= fullImages.length) {
      currentModalIndex = 0;
    } else {
      currentModalIndex = index;
    }

    const selectedImage = fullImages[currentModalIndex];
    const fullImageSrc = selectedImage.getAttribute("data-full");

    modalImage.src = fullImageSrc;

    if (modalCurrent) {
      modalCurrent.textContent = currentModalIndex + 1;
    }
  }

  function openModal(index) {
    showModalImage(index);
    imageModal.classList.add("show");
    document.body.classList.add("modal-open");
  }

  function closeModal() {
    imageModal.classList.remove("show");
    modalImage.src = "";
    document.body.classList.remove("modal-open");
  }

  fullImages.forEach(function (img, index) {
    img.addEventListener("click", function () {
      openModal(index);
    });
  });

  if (modalPrev) {
    modalPrev.addEventListener("click", function (event) {
      event.stopPropagation();
      showModalImage(currentModalIndex - 1);
    });
  }

  if (modalNext) {
    modalNext.addEventListener("click", function (event) {
      event.stopPropagation();
      showModalImage(currentModalIndex + 1);
    });
  }

  if (closeImageModal) {
    closeImageModal.addEventListener("click", function (event) {
      event.stopPropagation();
      closeModal();
    });
  }

  if (imageModal) {
    imageModal.addEventListener("click", function (event) {
      if (event.target === imageModal) {
        closeModal();
      }
    });
  }

  document.addEventListener("keydown", function (event) {
    const isModalOpen = imageModal.classList.contains("show");

    if (event.key === "Escape" && isModalOpen) {
      closeModal();
      return;
    }

    if (event.key === "ArrowLeft") {
      if (isModalOpen) {
        showModalImage(currentModalIndex - 1);
      } else {
        showSlide(currentSlide - 1);
      }
    }

    if (event.key === "ArrowRight") {
      if (isModalOpen) {
        showModalImage(currentModalIndex + 1);
      } else {
        showSlide(currentSlide + 1);
      }
    }
  });

  // ถ้ามีแค่รูปเดียว ซ่อนลูกศรใน Modal
  if (fullImages.length <= 1) {
    if (modalPrev) modalPrev.style.display = "none";
    if (modalNext) modalNext.style.display = "none";
  }
</script>